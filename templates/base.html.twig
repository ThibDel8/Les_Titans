<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <title>{% block title %}Les Titans | {% endblock %}</title>
    <link rel="icon" href="{{ asset('images/logo_image.png') }}">
    <link rel="stylesheet" href="{{ asset('css/main.css') }}">
    {% block stylesheets %}{% endblock %}
</head>

<body>
    <header class="header">
        <div class="container">
            <img src="{{ asset('images/logo_image.png') }}"/>
            <h1 class="brand">Les Titans</h1>
        </div>
    </header>

    <main class="container">
        {% block body %}{% endblock %}
    </main>

    <footer class="footer">
        <div class="container">
            <p>© 2025 - Les Titans</p>
            <p>Powered by Thibault Delattre</p>
        </div>
    </footer>

</body>
</html>
