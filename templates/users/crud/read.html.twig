{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Profil de {{ user.firstname }}{% endblock %}

{% block body %}
    {% set days = (user.medicalCertificateExpiry|date('U') - "now"|date('U')) // 86400 %}

    {% include '_partials/_breadcrumb/_breadcrumb.html.twig' with { breadcrumb: breadcrumb } %}

    <div class="right-content">
        {% if user.annualMembershipFee is null and user.accessBadgeNumber is not null %}
            <button class="btn btn-success" onclick="document.getElementById('confirm-renew').showModal()" title="Valider le renouvellement de l'adhésion">Renouveler</button>
            <dialog id="confirm-renew">
                <p>Vous êtes sur le point de renouveler l'adhésion de {{ user.firstname }} {{ user.lastname }}. Êtes vous sûr d'avoir reçu les 50€ de cotisation annuelle ?</p>
                <br>
                <form method="post"
                    action="{{ path('admin_user_renew', {id: user.id}) }}">
                    <input type="hidden" name="_token"
                        value="{{ csrf_token('renew_user_' ~ user.id) }}">

                    <button class="btn btn-warning" title="Valider le renouvellement de l'adhésion">Oui, renouveler</button>
                    <button class="btn btn-error" type="button" onclick="this.closest('dialog').close()" title="Annuler">Annuler</button>
                </form>
            </dialog>
        {% endif %}
        <a class="btn btn-info" href="{{ path('admin_user_update', {id: user.id}) }}" title="Modifier les informations du membre">Mettre à jour</a>
        {% if user.accessBadgeNumber is null and user.accessBadgeDeposit is null %}
            <button class="btn btn-error" onclick="document.getElementById('confirm-delete').showModal()" title="Supprimer ce membre">Supprimer</button>
            <dialog id="confirm-delete">
                <p>Êtes-vous sûr de vouloir supprimer ce membre ?</p>
                <br>
                <form method="post"
                    action="{{ path('admin_user_delete', {id: user.id}) }}">

                    <input type="hidden" name="_token"
                        value="{{ csrf_token('delete_user_' ~ user.id) }}">

                    <button class="btn btn-error" title="Supprimer ce membre">Oui, supprimer</button>
                    <button class="btn btn-warning" type="button" onclick="this.closest('dialog').close()" title="Annuler">Annuler</button>
                </form>
            </dialog>
        {% endif %}
        {% if user.accessBadgeNumber is not null and user.accessBadgeDeposit is not null %}
            <button class="btn btn-error" onclick="document.getElementById('confirm-restitution').showModal()" title="Valider la restitution de la caution et réception du badge">Restitution</button>
            <dialog id="confirm-restitution">
                <p>Vous êtes sur le point de valider la restitution de la caution de {{ user.firstname }} {{ user.lastname }} contre réception de son badge. Êtes vous sûr d'avoir rendu les 10€ de caution et récupéré le badge ?</p>
                <br>
                <form method="post"
                    action="{{ path('admin_user_restitution', {id: user.id}) }}">
                    <input type="hidden" name="_token"
                        value="{{ csrf_token('restitution_user_' ~ user.id) }}">

                    <button class="btn btn-warning" title="Valider la restitution de la caution et réception du badge">Oui, valider la restitution</button>
                    <button class="btn btn-error" type="button" onclick="this.closest('dialog').close()" title="Annuler">Annuler</button>
                </form>
            </dialog>
        {% endif %}
    </div>

    <section class="manager-section">
        <h2 class="manager-title">Profil de {{ user.firstname }} {{ user.lastname }}</h2>
        <div class="member-profile-image">
            <img src="{{ asset('images/profiles/uploads/' ~ user.profileImage ) }}" alt="Image de profil du membre">
            <p>{{ user.role }} (genre : {{ user.gender.label|trans }})</p>
            <p>
                Né{% if user.gender.value == 'female' %}e{% endif %} le {{ user.birthdate|date('d/m/Y') }}
                ({{ user.age }} ans)
            </p>
            {% if user.accessBadgeNumber is not null %}
                <p>Badge n° {{ user.accessBadgeNumber }}</p>
            {% endif %}
            {% if user.medicalCertificateExpiry|date('U') < "now"|date('U') and user.annualMembershipFee is not null %}
                <p>🩺 Certificat médical expiré depuis {{ days|abs }} jour{% if days < -1 %}s{% endif %}, {{ user.firstname }} doit mettre à jour son certificat médical.</p>
            {% endif %}
            {% if user.annualMembershipFee is null and user.accessBadgeNumber is not null %}
                <p>💰🔑 {{ user.firstname }} a encore son badge alors que son abonnement annuel est terminé.</p>
            {% endif %}
            {% if user.accessBadgeNumber is null and user.annualMembershipFee is not null %}
                <p>🔑 {{ user.firstname }} n'a pas encore de badge alors que son abonnement annuel est payé.</p>
            {% endif %}
        </div><br>
        <div class="member-contact-info">
            <a href="tel:+33{{ user.phone|slice(1) }}" title="Appeler {{ user.firstname }}">☎️ {{ user.phone }}</a>
            <p>🏠 {{ user.address }} {{ user.postalcode }}, {{ user.city }}</p>
            <a href="mailto:{{ user.email }}" title="Envoyer un email à {{ user.firstname }}">📧 {{ user.email }}</a>
            {% if days > 0 %}
                <p>
                    🩺 Certificat médical valable jusqu'au {{ user.medicalCertificateExpiry|fr_date }}
                    (encore {{ days }} jour{% if days > 1 %}s{% endif %}).
                </p>
            {% elseif days == 0 %}
                <p>
                    🩺 Certificat médical valable jusqu'à aujourd’hui.
                </p>
            {% endif %}
        </div>
    </section>

    {% if user.age < 18 %}
        <section class="manager-section">
            <h2 class="manager-title">Tuteur légal{% if user.tutorFirstname or user.tutorLastname %} : {{ user.tutorFirstname }} {{ user.tutorLastname }}{% endif %}</h2>
            <div class="member-contact-info">
                {% if user.tutorPhone %}<a href="tel:+33{{ user.tutorPhone|slice(1) }}" title="Appeler le tuteur légal de {{ user.firstname }}">☎️ {{ user.tutorPhone }}</a>{% else %}<p>☎️ Information obligatoire manquante</p>{% endif %}
                {% if user.tutorAddress and user.tutorPostalcode and user.tutorCity %}<p>🏠 {{ user.tutorAddress }} {{ user.tutorPostalcode }}, {{ user.tutorCity }}</p>{% else %}<p>🏠 Information obligatoire manquante</p>{% endif %}
                {% if user.tutorEmail %}<a href="mailto:{{ user.tutorEmail }}" title="Envoyer un email au tuteur légal de {{ user.firstname }}">📧 {{ user.tutorEmail }}</a>{% else %}<p>📧 Information obligatoire manquante</p>{% endif %}
            </div>
        </section>
    {% endif %}

    {% if user.accessBadgeNumber is null %}
        <section class="manager-section">
            <h2 class="manager-title">Attribuer un numéro de badge</h2>
            {{ form_start(form) }}
                {{ form_rest(form) }}
                <button class="btn" type="submit" title="Enregistrer le numéro de badge">Enregistrer</button>
            {{ form_end(form) }}
        </section>
    {% endif %}

    <div class="info-line">
        <span>Adhésion validée depuis le {{ user.createdAt|fr_datetime }}</span>
    </div>

{% endblock %}
