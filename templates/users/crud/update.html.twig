{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Profil de {{ user.firstname }}{% endblock %}

{% block body %}

    {% include '_partials/_breadcrumb/_breadcrumb.html.twig' with { breadcrumbs: breadcrumbs } %}

    <section class="manager-section">
        <h2 class="manager-title">Mise à jour du profil de {{ user.firstname }}</h2>
        {{ form_start(form) }}
            {{ form_rest(form) }}
            <button class="btn" type="submit" title="Enregistrer les modifications">Enregistrer</button>
        {{ form_end(form) }}
    </section>

{% endblock %}
