{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Liste des utilisateurs{% endblock %}

{% block body %}

    <h2 class="manager-title">Utilisateurs ({{ users|length }})</h2>

    {% for user in users %}
        <section class="manager-list-section">
            <a class="manager" href="" title="Voir les informations de l'utilisateur {{ user.member.firstname|capitalize }} {{ user.member.lastname|capitalize }}">
                <div class="user-list-names">
                    <img src="{{ asset('images/profiles/uploads/' ~ user.member.profileImage) }}" alt="Image de profil de l'utilisateur">
                    <div>
                        <p>{{ user.member.firstname|capitalize }} {{ user.member.lastname|capitalize }}</p>
                        <div class="user-list-role">{{ user.roles[0]|replace({'_': ' '})|lower|capitalize }}</div>
                    </div>
                </div>
            </a>
        </section>
    {% else %}
        <p>Aucun utilisateur pour le moment.</p>
    {% endfor %}

{% endblock %}
