{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Manager Saint-Ouen Musculation{% endblock %}

{% block body %}
    <section class="manager-section">
        <h2 class="manager-title">Création du mot de passe</h2>
        <p>{{ user.member.firstname }},</p>
        <p>Pour sécuriser votre compte, merci de définir un mot de passe sûr ci-dessous.</p><br>
        {{ form_start(form) }}
            {{ form_row(form.plainPassword) }}
            <button type="submit" class="btn btn-warning">Créer</button>
        {{ form_end(form) }}
    </section>
{% endblock %}
