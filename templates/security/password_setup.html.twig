{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Mot de passe{% endblock %}

{% block body %}
    <section class="public-section">
        <h2 class="public-title">Création du mot de passe</h2>
        <p>{{ user.firstname }},</p>
        <p>Pour sécuriser votre compte, merci de définir un mot de passe sûr ci-dessous.</p><br>
        {{ form_start(form) }}
            {{ form_row(form.plainPassword) }}
            <button type="submit" class="btn btn-warning">Créer</button>
        {{ form_end(form) }}
    </section>
{% endblock %}
