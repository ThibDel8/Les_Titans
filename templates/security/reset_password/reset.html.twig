{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Réinitialisation du mot de passe{% endblock %}

{% block body %}
    <section class="public-section">
        <h2 class="public-title">Réinitialiser votre mot de passe</h2>

        {{ form_start(resetForm) }}
            {{ form_row(resetForm.plainPassword) }}
            <button class="btn">Enregistrer</button>
        {{ form_end(resetForm) }}
    </section>
{% endblock %}
