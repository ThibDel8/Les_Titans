<section class="manager-{{ status }}-section">
    <a class="manager" href="{{ path('admin_member_read', {id: member.id}) }}" title="Cliquer pour voir le membre">
        <div class="member-list-names">
            <img src="{{ asset('images/profiles/' ~ member.profileImage) }}">
            <div>
                <p>
                {{ member.firstname|capitalize }} {{ member.lastname|capitalize }}
                {% if member.medicalCertificateExpiry|date('U') < "now"|date('U') and member.annualMembershipFee is not null %}🩺{% endif %}
                {% if member.annualMembershipFee is null and member.accessBadgeNumber is not null %}💰🔑{% endif %}
                {% if member.accessBadgeNumber is null and member.annualMembershipFee is not null %}🔑{% endif %}
                </p>
            </div>
        </div>
    </a>
</section>
