{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Profil de {{ member.firstname }}{% endblock %}

{% block body %}

    <div class="right-content">
        {% if member.annualMembershipFee is null and member.accessBadgeNumber is not null %}
            <button class="btn btn-success" onclick="document.getElementById('confirm-renew').showModal()" title="Valider le renouvellement de l'adhésion">Renouveler</button>
            <dialog id="confirm-renew">
                <p>Vous êtes sur le point de renouveler l'adhésion de {{ member.firstname }} {{ member.lastname }}. Êtes vous sûr d'avoir reçu les 50€ de cotisation annuelle ?</p>
                <br>
                <form method="post"
                    action="{{ path('admin_member_renew', {id: member.id}) }}">
                    <input type="hidden" name="_token"
                        value="{{ csrf_token('renew_user_' ~ member.id) }}">

                    <button class="btn btn-warning" title="Valider le renouvellement de l'adhésion">Oui, renouveler</button>
                    <button class="btn btn-error" type="button" onclick="this.closest('dialog').close()" title="Annuler">Annuler</button>
                </form>
            </dialog>
        {% endif %}
        {% if member.user is null %}
            <button class="btn btn-warning" onclick="document.getElementById('confirm-create').showModal()" title="Rendre ce membre manager">Rendre Manager</button>
            <dialog id="confirm-create">
                <p>Êtes-vous sûr de vouloir rendre ce membre manager ?</p>
                <br>
                <form method="post"
                    action="{{ path('admin_user_create', {id: member.id}) }}">

                    <input type="hidden" name="_token"
                        value="{{ csrf_token('create_user_' ~ member.id) }}">

                    <button class="btn btn-warning" title="Rendre ce membre manager">Oui, rendre manager</button>
                    <button class="btn btn-error" type="button" onclick="this.closest('dialog').close()" title="Annuler">Annuler</button>
                </form>
            </dialog>
        {% endif %}
        <a class="btn btn-info" href="{{ path('admin_member_update', {id: member.id}) }}" title="Modifier les informations du membre">Mettre à jour</a>
        {% if member.accessBadgeNumber is null and member.accessBadgeDeposit is null %}
            <button class="btn btn-error" onclick="document.getElementById('confirm-delete').showModal()" title="Supprimer ce membre">Supprimer</button>
            <dialog id="confirm-delete">
                <p>Êtes-vous sûr de vouloir supprimer ce membre ?</p>
                <br>
                <form method="post"
                    action="{{ path('admin_member_delete', {id: member.id}) }}">

                    <input type="hidden" name="_token"
                        value="{{ csrf_token('delete_member_' ~ member.id) }}">

                    <button class="btn btn-error" title="Supprimer ce membre">Oui, supprimer</button>
                    <button class="btn btn-warning" type="button" onclick="this.closest('dialog').close()" title="Annuler">Annuler</button>
                </form>
            </dialog>
        {% else %}
            <button class="btn btn-error" onclick="document.getElementById('confirm-restitution').showModal()" title="Valider la restitution de la caution et réception du badge">Restitution</button>
            <dialog id="confirm-restitution">
                <p>Vous êtes sur le point de valider la restitution de la caution de {{ member.firstname }} {{ member.lastname }} contre réception de son badge. Êtes vous sûr d'avoir rendu les 10€ de caution et récupéré le badge ?</p>
                <br>
                <form method="post"
                    action="{{ path('admin_member_restitution', {id: member.id}) }}">
                    <input type="hidden" name="_token"
                        value="{{ csrf_token('restitution_user_' ~ member.id) }}">

                    <button class="btn btn-warning" title="Valider la restitution de la caution et réception du badge">Oui, valider la restitution</button>
                    <button class="btn btn-error" type="button" onclick="this.closest('dialog').close()" title="Annuler">Annuler</button>
                </form>
            </dialog>
        {% endif %}
    </div>

    <section class="manager-section">
        <h2 class="manager-title">Profil de {{ member.firstname }} {{ member.lastname }}</h2>
        <div class="member-profile-image">
            <img src="{{ asset('images/profiles/uploads/' ~ member.profileImage ) }}" alt="Image de profil du membre">
            <p>
                {{ member.gender.label|trans }}
            </p>
            <p>
                Né{% if member.gender.value == 'female' %}e{% endif %} le {{ member.birthdate|date('d/m/Y') }}
                ({{ member.age }} ans)
            </p>
            {% if member.accessBadgeNumber is not null %}
                <p>Badge n° {{ member.accessBadgeNumber }}</p>
            {% endif %}
            {% if member.medicalCertificateExpiry|date('U') < "now"|date('U') and member.annualMembershipFee is not null %}
                <p>🩺 {{ member.firstname }} doit mettre à jour son certificat médical.</p>
            {% endif %}
            {% if member.annualMembershipFee is null and member.accessBadgeNumber is not null %}
                <p>💰🔑 {{ member.firstname }} a encore son badge alors que son abonnement annuel est terminé.</p>
            {% endif %}
            {% if member.accessBadgeNumber is null and member.annualMembershipFee is not null %}
                <p>🔑 {{ member.firstname }} n'a pas encore de badge alors que son abonnement annuel est payé.</p>
            {% endif %}
        </div><br>
        <div class="member-contact-info">
            <a href="tel:+33{{ member.phone|slice(1) }}" title="Appeler {{ member.firstname }}">☎️ {{ member.phone }}</a><br>
            <p>🏠 {{ member.address }} {{ member.postalcode }}, {{ member.city }}</p><br>
            <a href="mailto:{{ member.email }}" title="Envoyer un email à {{ member.firstname }}">📧 {{ member.email }}</a>
        </div>
    </section>

{% if member.age < 18 %}
    <section class="manager-section">
        <h2 class="manager-title">Tuteur légal{% if member.tutorFirstname or member.tutorLastname %} : {{ member.tutorFirstname }} {{ member.tutorLastname }}{% endif %}</h2>
        <div class="member-contact-info">
            {% if member.tutorPhone %}<a href="tel:+33{{ member.tutorPhone|slice(1) }}" title="Appeler le tuteur légal de {{ member.firstname }}">☎️ {{ member.tutorPhone }}</a><br>{% else %}<p>☎️ Information obligatoire manquante</p>{% endif %}
            {% if member.tutorAddress and member.tutorPostalcode and member.tutorCity %}<p>🏠 {{ member.tutorAddress }} {{ member.tutorPostalcode }}, {{ member.tutorCity }}</p><br>{% else %}<p>🏠 Information obligatoire manquante</p>{% endif %}
            {% if member.tutorEmail %}<a href="mailto:{{ member.tutorEmail }}" title="Envoyer un email au tuteur légal de {{ member.firstname }}">📧 {{ member.tutorEmail }}</a><br>{% else %}<p>📧 Information obligatoire manquante</p>{% endif %}
        </div>
    </section>
{% endif %}



{% if member.accessBadgeNumber is null %}
<section class="manager-section">
    <h2 class="manager-title">Attribuer un numéro de badge</h2>
    {{ form_start(form) }}
        {{ form_rest(form) }}
        <button type="submit" title="Enregistrer le numéro de badge">Enregistrer</button>
    {{ form_end(form) }}
</section>
{% endif %}

<div class="info-line">
    <span>Adhésion validée depuis le {{ member.createdAt|fr_date }}</span>
</div>

{% endblock %}
