{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Administration{% endblock %}

{% block h1 %}Administration{% endblock %}

{% block body %}

    {% include '_partials/_breadcrumb/_breadcrumb.html.twig' with { breadcrumbs: breadcrumbs } %}

    <section class="manager-section">
        <h2 class="manager-title">Tableau de bord</h2>
        <div class="dashboard">
            <ul>
                <li>
                    <a href="{{ path('admin_user_list') }}" title="Liste des membres">
                        {% include 'icons/members.svg.twig' %} Membres ({{ nbUsers }})
                    </a>
                </li>
                <li>
                    <a href="{{ path('admin_contact_message_list') }}" title="Voir les messages">
                        {% include 'icons/contact-messages.svg.twig' %} Messages ({{ nbUnreadMessages }})
                    </a>
                </li>
                <li>
                    <a href="{{ path('admin_membership_list') }}" title="Voir les demandes d'adhésion">
                        {% include 'icons/memberships.svg.twig' %} Adhésions ({{ nbMemberships }})
                    </a>
                </li>
                <li>
                    <a href="{{ path('admin_document_list') }}" title="Voir les documents à télécharger">
                        {% include 'icons/document.svg.twig' %} Documents
                    </a>
                </li>
            </ul>
        </div>
    </section>

    {% if is_granted('ROLE_ADMIN') %}
        <section class="manager-section">
            <h2 class="manager-title">Derniers logs enregistrés</h2>
            <div>
            {% if logs is not empty %}
                {% for log in logs %}
                    <p><span class="log-datetime">[{{ log.occurredAt|fr_datetime }}]</span> &rarr; {{ log.authorFullname }} a {{ log.action.logLabel }} : {{ log.entityType.label }}{% if log.message is not null %} ({{ log.message }}){% endif %}.</p>
                {% endfor %}
            {% else %}
                <p>Pas encore de logs.</p>
            {% endif %}
            </div>
        </section>
    {% endif %}

{% endblock %}
