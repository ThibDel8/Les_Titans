{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Accueil{% endblock %}

{% block maps %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
{% endblock %}

{% block body %}

{% if app.user %}
    <div class="user-container">
        <div class="profil-container">
            <a href="{{ path('app_profile_read') }}" title="Voir le profil">
                <img src="{{ asset('images/profiles/uploads/' ~ app.user.profileImage) }}" alt="Image de profil de l'utilisateur connecté"/>
                <h2 class="public-title">{{ app.user.firstname }}</h2>
            </a>
        </div>
    </div>
{% endif %}

<section class="public-section">
    <h2 class="public-title">Présentation</h2>
    <p>
        La salle de musculation communale est une association locale destinée aux habitants souhaitant pratiquer
        la musculation dans un cadre encadré, sécurisé et respectueux des règles.
    </p>
    <p>
        L'accès est réservé aux membres à jour de leur adhésion, de leur certificat médical et du règlement intérieur.
    </p>
</section>

<section class="public-section">
    <h2 class="public-title">Informations pratiques</h2>
    <div class="infos-grid">
        <div class="subsection">
            <h3>⏰ Horaires</h3>
            <ul class="schedules">
            <li><span>Lundi</span><span>7h – 22h</span></li>
            <li><span>Mardi</span><span>7h – 22h</span></li>
            <li><span>Mercredi</span><span>7h – 22h</span></li>
            <li><span>Jeudi</span><span>7h – 22h</span></li>
            <li><span>Vendredi</span><span>7h – 22h</span></li>
            <li><span>Samedi</span><span>7h – 22h</span></li>
            <li><span>Dimanche</span><span>7h – 22h</span></li>
        </ul>
        </div>
        <div class="subsection">
            <h3>📍 Localisation</h3>
            <div>
                <div id="map" style="height: 250px;"></div>
            </div>
        </div>
    </div>
</section>

<section class="public-section">
    <h2 class="public-title">Fonctionnement et règles</h2>
    <p>
        Badge obligatoire pour accéder à la salle
        Certificat médical valide requis
        Respect du matériel et des autres membres
        Nettoyage des machines après utilisation
    </p>
</section>

{% endblock %}

{% block javascripts %}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    // Centre la carte sur l'adresse avec géocodage léger OSM
    const query = "Cité Saint-Jules, 80610 Saint-Ouen, France";

    // Appelle l’API Nominatim (OSM) pour obtenir la lat/lng
    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`)
        .then(response => response.json())
        .then(data => {
            if (!data || data.length === 0) {
                console.error("Adresse non trouvée !");
                return;
            }

            const lat = parseFloat(data[0].lat);
            const lon = parseFloat(data[0].lon);

            // Initialise la carte
            const map = L.map("map").setView([lat, lon], 16);

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                attribution: "&copy; OpenStreetMap"
            }).addTo(map);

            // Ajoute un marqueur
            L.marker([lat, lon]).addTo(map)
                .bindPopup("<strong>Salle de musculation Les Titans</strong><br>Cité Saint-Jules, 80610 Saint-Ouen")
                .openPopup();
        })
        .catch(err => console.error("Erreur géocodage :", err));
</script>

{% endblock %}
