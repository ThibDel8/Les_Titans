<header>
    <div class="header-container">

        <div class="logo-title">
            <a href="{{ path('app_home') }}" title="Se rendre à l'accueil">
                <img src="{{ asset('images/logo_image.png') }}" alt="Logo du site"/>
            </a>
            <div class="title-text">
                <h1>Les Titans</h1>
                <p>Saint-Ouen Musculation</p>
            </div>
        </div>

        <!-- burger button -->
        <input type="checkbox" id="menu-toggle" class="menu-toggle" />
        <label for="menu-toggle" class="burger">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <div class="nav-links">
            <nav>
                <ul>
                    <li><a class="{{ app.request.pathInfo == path('app_home') ? 'active' : '' }}" href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a class="{{ app.request.pathInfo == path('app_membership_create') ? 'active' : '' }}" href="{{ path('app_membership_create') }}">Demande d'adhésion</a></li>
                    <li><a class="{{ app.request.pathInfo == path('app_contact') ? 'active' : '' }}" href="{{ path('app_contact') }}">Contact</a></li>
                    <li><a class="{{ app.request.pathInfo == path('app_about') ? 'active' : '' }}" href="{{ path('app_about') }}">À propos</a></li>
                    {% if app.user %}
                        <li>
                            <a class="btn-logout {{ app.request.pathInfo == path('app_logout') ? 'active' : '' }}" onclick="document.getElementById('confirm-logout').showModal()" title="Se déconnecter">
                                {% include 'icons/logout.svg.twig' %}
                            </a>
                        </li>
                    {% else %}
                        <li><a class="{{ app.request.pathInfo == path('app_login') ? 'active' : '' }}" href="{{ path('app_login') }}">Connexion</a></li>
                    {% endif %}
                </ul>
            </nav>
            <dialog id="confirm-logout">
                <p>Êtes-vous sûr de vouloir vous déconnecter ?</p>
                <br>
                <form method="get"
                    action="{{ path('app_logout') }}">

                    <input type="hidden" name="_token"
                        value="{{ csrf_token('logout') }}">

                    <button class="btn btn-error" title="Se déconnecter">Oui, se déconnecter</button>
                    <button class="btn btn-warning" type="button" onclick="this.closest('dialog').close()" title="Annuler">Annuler</button>
                </form>
            </dialog>
        </div>

    </div>
</header>
