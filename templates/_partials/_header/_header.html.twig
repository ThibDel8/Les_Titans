<header>
    <div class="header-container">

        <div class="logo-title">
            <a href="{{ path('app_home') }}" title="Retour à l'accueil">
                <img src="{{ asset('images/logos/les_titans_img_txt.png') }}" alt="Logo de l'association">
            </a>
        </div>

        <input type="checkbox" id="menu-toggle" class="menu-toggle">
        <label for="menu-toggle" class="burger" aria-label="Ouvrir le menu">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <nav class="nav-links" aria-label="Navigation principale">
            <ul>
                <li>
                    <a class="{{ app.request.pathInfo == path('app_home') ? 'active' : '' }}" href="{{ path('app_home') }}">
                        {% include 'icons/home.svg.twig' %}
                        Accueil
                    </a>
                </li>

                {% if app.user %}
                {% else %}
                    <li>
                        <a class="{{ app.request.pathInfo == path('app_membership_create') ? 'active' : '' }}" href="{{ path('app_membership_create') }}">
                            {% include 'icons/memberships.svg.twig' %}
                            Adhésions
                        </a>
                    </li>

                    <li>
                        <a class="{{ app.request.pathInfo == path('app_contact') ? 'active' : '' }}" href="{{ path('app_contact') }}">
                            {% include 'icons/contact-messages.svg.twig' %}
                            Contact
                        </a>
                    </li>

                    <li>
                        <a class="{{ app.request.pathInfo == path('app_about') ? 'active' : '' }}" href="{{ path('app_about') }}">
                            {% include 'icons/about.svg.twig' %}
                            À propos
                        </a>
                    </li>
                {% endif %}
                {% if is_granted('ROLE_SECRETARY') %}
                    <li>
                        <a class="{{ app.request.attributes.get('_route') in [
                            'admin_dashboard',
                            'admin_user_list',
                            'admin_user_read',
                            'admin_user_update',
                            'admin_contact_message_list',
                            'admin_contact_message_read',
                            'admin_membership_list',
                            'admin_membership_read',
                            'admin_document',
                            'admin_document_download_outdoor_info_sheet',
                        ] ? 'active-manager ' : '' }}manager-text" href="{{ path('admin_dashboard') }}">
                            {% include 'icons/dashboard.svg.twig' %}
                            Administration
                        </a>
                    </li>
                {% endif %}

                {% if app.user %}
                    <li>
                        <a class="{{ app.request.pathInfo == path('app_post_list') ? 'active' : '' }}" href="{{ path('app_post_list') }}">
                            {% include 'icons/news.svg.twig' %}
                            Publications
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_logout') }}" onclick="document.getElementById('confirm-logout').showModal()" title="Se déconnecter">
                            {% include 'icons/logout.svg.twig' %}
                            Se déconnecter
                        </a>
                    </li>
                {% else %}
                    <li>
                        <a class="{{ app.request.pathInfo == path('app_login') ? 'active' : '' }}" href="{{ path('app_login') }}">
                            {% include 'icons/login.svg.twig' %}
                            Connexion
                        </a>
                    </li>
                {% endif %}
            </ul>
        </nav>

    </div>
</header>
