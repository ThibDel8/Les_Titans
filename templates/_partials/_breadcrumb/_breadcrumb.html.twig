<nav class="nav-breadcrumb" aria-label="Fil d'Ariane">
    <ol class="breadcrumb">
        {% for item in breadcrumb %}
            {% if item.path %}
                <li><a href="{{ item.path }}">{{ item.label }}</a></li>
            {% else %}
                <li aria-current="page">{{ item.label }}</li>
            {% endif %}
        {% endfor %}
    </ol>
</nav>
