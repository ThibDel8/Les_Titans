<nav class="nav-breadcrumb" aria-label="Fil d'Ariane">
    <ol class="breadcrumb">
        {% for item in breadcrumbs %}
            <li class="breadcrumb-item {% if not item.route %}active{% endif %}">
                {% if item.route %}
                    <a href="{{ path(item.route, item.parameters) }}">{{ item.label }}</a>
                {% else %}
                    {{ item.label }}
                {% endif %}
            </li>
        {% endfor %}
    </ol>
</nav>
