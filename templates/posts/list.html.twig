{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Publications{% endblock %}

{% block body %}

    {% include '_partials/_breadcrumb/_breadcrumb.html.twig' with { breadcrumbs: breadcrumbs } %}

    <h2 class="public-title">Publications</h2>

    <div class="right-content">
        <a class="btn btn-info" href="{{ path('app_post_create') }}" title="Ajouter une publication">Écrire</a>
    </div>

    {% for post in posts %}
        <section class="public-section">
            <div class="author-post">
                <img src="
                    {% if post.author %}
                        {{ asset('images/profiles/uploads/' ~ post.author.profileImage) }}
                    {% else %}
                        {{ asset('images/profiles/defaults/ghost_default_profile.png.png') }}
                    {% endif %}
                " alt="Image de profil de l'auteur du poste">
                <div class="post-info">
                    <p>
                        {% if post.author %}
                            {{ post.author.firstname }} {{ post.author.lastname }}
                        {% else %}
                            Ancien membre
                        {% endif %}
                    </p>
                    <time class="post-date" datetime="{{ post.createdAt|date('c') }}">
                        <small>{{ post.createdAt|fr_datetime }}</small>
                    </time>
                </div>
                {% if app.user == post.author or is_granted('ROLE_VICE_PRESIDENT') %}
                    {% include 'icons/trash.svg.twig' with {
                        onclick: "document.getElementById('confirm-delete-" ~ post.id ~ "').showModal()",
                        title: "Supprimer cette publication"
                    } %}
                    <dialog id="confirm-delete-{{ post.id }}">
                        <p>Êtes-vous sûr de vouloir supprimer cette publication, et tous ses commentaires ?</p>
                        <br>
                        <form method="post" action="{{ path('app_post_delete', {id: post.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_post_' ~ post.id) }}">
                            <button class="btn btn-error" title="Supprimer cette publication">Oui, supprimer</button>
                            <button class="btn btn-warning" type="button" onclick="this.closest('dialog').close()" title="Annuler">Annuler</button>
                        </form>
                    </dialog>
                {% endif %}
            </div>
            <div>
                <p>{{ post.text }}</p>
            </div>
            <br>

            <a href="{{ path('app_post_read', {'id': post.id}) }}">{{ post.comments|length }} commentaire{% if post.comments|length > 1 %}s{% endif %}</a>
        </section>
    {% else %}
        <p>Aucune publication pour le moment.</p>
    {% endfor %}

{% endblock %}
