{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Publication{% endblock %}

{% block body %}

    {% include '_partials/_breadcrumb/_breadcrumb.html.twig' with { breadcrumb: breadcrumb } %}

    <h2 class="public-title">Publication</h2>
    <div class="author-post">
        {% if post.author %}
            <img src="{{ asset('images/profiles/uploads/' ~ post.author.profileImage) }}" alt="Image de profil de l'auteur du poste">
            <div class="post-info">
                <p>{{ post.author.firstname }} {{ post.author.lastname }}</p>
                <time class="post-date" datetime="{{ post.createdAt|date('c') }}">
                    <small>{{ post.createdAt|fr_datetime }}</small>
                </time>
            </div>
        {% else %}
            <img src="{{ asset('images/profiles/defaults/ghost_default_profile.png.png') }}" alt="Image de profil de l'auteur du poste">
            <div class="post-info">
                <p>Ancien membre</p>
                <time class="post-date" datetime="{{ post.createdAt|date('c') }}">
                    <small>{{ post.createdAt|fr_datetime }}</small>
                </time>
            </div>
        {% endif %}
    </div>
    <div>
        <p>{{ post.text }}</p><br>
    </div>

    <section class="public-section">
        {% if comments|length > 0 %}
            <h3>{{ comments|length }} commentaire{% if comments|length > 1 %}s{% endif %}</h3><br>
            <div class="comments-container">
                {% for comment in comments %}
                    <div class="comment-content">
                        <div class="comment-author">
                            {% if comment.author %}
                                <img src="{{ asset('images/profiles/uploads/' ~ comment.author.profileImage) }}" alt="Image de profil de l'auteur du commentaire">
                                <div class="post-info">
                                    <p>{{ comment.author.firstname }} {{ comment.author.lastname }}</p>
                                    <time class="post-date" datetime="{{ comment.createdAt|date('c') }}">
                                        <small>{{ comment.createdAt|fr_datetime }}</small>
                                    </time>
                                </div>
                            {% else %}
                                <img src="{{ asset('images/profiles/defaults/ghost_default_profile.png.png') }}" alt="Image de profil de l'auteur du commentaire">
                                <div class="post-info">
                                    <p>Ancien membre</p>
                                    <time class="post-date" datetime="{{ comment.createdAt|date('c') }}">
                                        <small>{{ comment.createdAt|fr_datetime }}</small>
                                    </time>
                                </div>
                            {% endif %}
                        </div>
                        <p>{{ comment.text }}</p>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div>
                <p>Pas encore de commentaire.</p>
            </div>
        {% endif %}
    </section>
    <br>

    {{ form_start(form) }}
        {{ form_rest(form) }}
        <button class="btn" type="submit" title="Commenter la publication">Répondre</button>
    {{ form_end(form) }}

{% endblock %}

