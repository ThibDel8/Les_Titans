{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Publication{% endblock %}

{% block h1 %}Commentaires{% endblock %}

{% block body %}

    {% include '_partials/_breadcrumb/_breadcrumb.html.twig' with { breadcrumbs: breadcrumbs } %}
    <div class="author-post">
        <img src="
            {% if post.author %}
                {{ asset('images/profiles/uploads/' ~ post.author.profileImage) }}
            {% else %}
                {{ asset('images/profiles/defaults/ghost_default_profile.png.png') }}
            {% endif %}
        " alt="Image de profil de l'auteur du poste">
        <div class="post-info">
            <p>
                {% if post.author %}
                    {{ post.author.firstname }} {{ post.author.lastname }}
                {% else %}
                    Ancien membre
                {% endif %}
            </p>
            <time class="post-date" datetime="{{ post.createdAt|date('c') }}">
                <small>{{ post.createdAt|fr_datetime }}</small>
            </time>
        </div>
        {% if app.user == post.author or is_granted('ROLE_VICE_PRESIDENT') %}
            {% include 'icons/trash.svg.twig' with {
                onclick: "document.getElementById('confirm-delete-" ~ post.id ~ "').showModal()",
                title: "Supprimer cette publication"
            } %}
            <dialog id="confirm-delete-{{ post.id }}">
                <p>Êtes-vous sûr de vouloir supprimer cette publication, et tous ses commentaires ?</p>
                <br>
                <form method="post" action="{{ path('app_post_delete', {id: post.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_post_' ~ post.id) }}">
                    <button class="btn btn-error" title="Supprimer cette publication">Oui, supprimer</button>
                    <button class="btn btn-warning" type="button" onclick="this.closest('dialog').close()" title="Annuler">Annuler</button>
                </form>
            </dialog>
        {% endif %}
    </div>
    <div>
        <p>{{ post.text }}</p><br>
    </div>

    <section class="public-section">
        {% if comments|length > 0 %}
            <h3>{{ comments|length }} commentaire{% if comments|length > 1 %}s{% endif %}</h3><br>
            <div class="comments-container">
                {% for comment in comments %}
                    <div class="comment-content">
                        <div class="comment-author">
                            <img src="
                                {% if comment.author %}
                                    {{ asset('images/profiles/uploads/' ~ comment.author.profileImage) }}
                                {% else %}
                                    {{ asset('images/profiles/defaults/ghost_default_profile.png.png') }}
                                {% endif %}
                            " alt="Image de profil de l'auteur du commentaire">
                            <div class="post-info">
                                <p>
                                    {% if comment.author %}
                                        {{ comment.author.firstname }} {{ comment.author.lastname }}
                                    {% else %}
                                        Ancien membre
                                    {% endif %}
                                </p>
                                <time class="post-date" datetime="{{ comment.createdAt|date('c') }}">
                                    <small>{{ comment.createdAt|fr_datetime }}</small>
                                </time>
                            </div>
                            {% if app.user == comment.author or is_granted('ROLE_VICE_PRESIDENT') %}
                                {% include 'icons/trash.svg.twig' with {
                                    onclick: "document.getElementById('confirm-delete-" ~ comment.id ~ "').showModal()",
                                    title: "Supprimer ce commentaire"
                                } %}
                                <dialog id="confirm-delete-{{ comment.id }}">
                                    <p>Êtes-vous sûr de vouloir supprimer ce commentaire ?</p>
                                    <br>
                                    <form method="post" action="{{ path('app_post_comment_delete', {id: comment.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comment.id) }}">
                                        <button class="btn btn-error" title="Supprimer ce commentaire">Oui, supprimer</button>
                                        <button class="btn btn-warning" type="button" onclick="this.closest('dialog').close()" title="Annuler">Annuler</button>
                                    </form>
                                </dialog>
                            {% endif %}
                        </div>
                        <p>{{ comment.text }}</p>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div>
                <p>Pas encore de commentaire.</p>
            </div>
        {% endif %}
    </section>
    <br>

    {{ form_start(form) }}
        {{ form_rest(form) }}
        <button class="btn" type="submit" title="Commenter la publication">Répondre</button>
    {{ form_end(form) }}

{% endblock %}

