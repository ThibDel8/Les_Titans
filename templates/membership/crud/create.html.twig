{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Adhésion{% endblock %}

{% block h1 %}Demande d'adhésion{% endblock %}

{% block body %}

    {% include '_partials/_breadcrumb/_breadcrumb.html.twig' with { breadcrumbs: breadcrumbs } %}

    <section class="public-section">
        <h2 class="public-title">Inscription</h2>

        <p>
            L’adhésion à la salle est de <strong>{{ annual_fee }} € par an</strong> et permet l’obtention d’un <strong>badge d’accès</strong>
            (caution de <strong>{{ access_badge_deposit }} €</strong>, restituée lors de la restitution du badge).
        </p>

        <p>
            Une fois le formulaire validé, un document récapitulatif vous sera fourni.
            Il devra être <strong>imprimé et signé</strong>, puis remis en main propre avec :
        </p>

        <ul>
            <li>les <strong>{{ annual_fee }} € en espèces</strong> de cotisation</li>
            <li>les <strong>{{ access_badge_deposit }} € de caution</strong></li>
            <li>un <strong>certificat médical valide</strong></li>
        </ul>

        <p>
            L’adhésion actuelle est valable jusqu’au <strong>31 décembre {{ "now"|date("Y") }}</strong>.
        </p>
        <br>

        <p>
            Si vous inscrivez une autre personne, merci d’indiquer uniquement ses informations.
            Pour un mineur, les coordonnées du tuteur légal sont obligatoires.
        </p>
        <br><br>

        {{ form_start(form) }}

            <h3 class="public-title">Informations du membre</h3>
            {{ form_row(form.lastname) }}
            {{ form_row(form.firstname) }}
            {{ form_row(form.birthdate) }}
            {{ form_row(form.gender) }}
            {{ form_row(form.phone) }}
            {{ form_row(form.address) }}
            {{ form_row(form.postalcode) }}
            {{ form_row(form.city) }}
            {{ form_row(form.email) }}
            {{ form_row(form.profileImage) }}
            <div class="tutor-fields" id="tutor-fields">
                {{ form_row(form.tutorLastname) }}
                {{ form_row(form.tutorFirstname) }}
                {{ form_row(form.tutorPhone) }}
                {{ form_row(form.tutorEmail) }}
                {{ form_row(form.tutorAddress) }}
                {{ form_row(form.tutorPostalcode) }}
                {{ form_row(form.tutorCity) }}
            </div>
            <br>

            <div class="form-check">
                {{ form_widget(form.acceptedRules) }}
                <label class="form-check-label" for="{{ form.acceptedRules.vars.id }}">
                    J'ai lu et j'accepte le <a class="required" href="{{ path('app_house_rules') }}" target="_blank">règlement intérieur de l'association</a>
                </label>
            </div>
            <br>

            <button class="btn" type="submit" title="Envoyer la demande d'adhésion">Envoyer la demande</button>
        {{ form_end(form) }}
    </section>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const birthdateInput = document.getElementById('{{ form.birthdate.vars.id }}');
            const tutorFields = document.getElementById('tutor-fields');

            function isMinor(birthdateValue) {
                if (!birthdateValue) {
                    return false;
                }

                const birthdate = new Date(birthdateValue);
                const today = new Date();

                let age = today.getFullYear() - birthdate.getFullYear();
                const monthDiff = today.getMonth() - birthdate.getMonth();

                if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthdate.getDate())) {
                    age--;
                }

                return age < 18;
            }

            function toggleTutorFields() {
                if (isMinor(birthdateInput.value)) {
                    tutorFields.style.display = 'grid';
                } else {
                    tutorFields.style.display = 'none';
                }
            }

            // État initial
            toggleTutorFields();

            // Quand la date change
            birthdateInput.addEventListener('change', toggleTutorFields);
        });
    </script>


{% endblock %}
