<section class="manager-section">
    <a href="{{ path('admin_contact_message_read', {id: message.id}) }}" title="Cliquer pour lire le message">
        <div class="message-card-content">
            <div class="message-card-main">
                <h3 class="message-subject manager-text">{{ message.subject }}</h3>
                <small class="message-email">Envoyé par {{ message.email }}</small>
                <time class="message-date" datetime="{{ message.createdAt|date('c') }}">
                    <small>{{ message.createdAt|fr_datetime }}</small>
                </time>
            </div>
            <span class="contact-message-status {{ message.status.value }}">
                {{ message.status.label }}
            </span>
        </div>
    </a>
</section>
