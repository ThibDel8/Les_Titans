<section class="manager-section">
    <a class="manager" href="{{ path('admin_contact_message_read', {id: message.id}) }}" title="Cliquer pour lire le message">
        <div class="message-list-names">
            <div>
                <p>{{ message.subject }}</p>
                <div class="message-list-date">
                    <p>Envoyé par {{ message.email }}.</p>
                    <p>{{ message.createdAt|fr_datetime }}</p>
                </div>
            </div>
        </div>
    </a>
</section>
