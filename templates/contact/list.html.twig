{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Liste des messages{% endblock %}

{% block body %}
    {% set isUnreadMessages = messages|filter(message => message.assignedTo is null) %}

    {% include '_partials/_breadcrumb/_breadcrumb.html.twig' with { breadcrumbs: breadcrumbs } %}

    <h2 class="manager-title">Messages ({{ isUnreadMessages|length }})</h2>

    {% for message in messages %}
        {% include 'contact/_card/_messages_list.html.twig' with { message: message } %}
    {% else %}
        <p>Aucun message pour le moment.</p>
    {% endfor %}

{% endblock %}
