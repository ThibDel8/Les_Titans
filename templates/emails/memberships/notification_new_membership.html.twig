{% extends 'emails/base.html.twig' %}

{% block subject %}{{ parent() }}Adhésion{% endblock %}

{% block body %}

    <h1 style="color: {{ colors.publicColor }}; padding-bottom: 20px;">Nouvelle demande d'adhésion</h1>
    <section style="
        background-color: {{ colors.grey }};
        border-radius: 4px;
        padding: 25px;
        margin-bottom: 40px;
        border-left: 5px solid {{ colors.publicColor }};
    ">
        <div style="color: {{ colors.greyLight }};">
            <p>Bonjour,</p>
            <p>Vous avez reçu une nouvelle demande d’adhésion.</p>
            <p>
                La personne est actuellement en attente d’un contact avec l’un des dirigeants pour convenir d’un rendez-vous à la salle de sport.
                Ce rendez-vous permettra de fournir les documents nécessaires et de procéder au paiement de l’adhésion.
            </p>
            <p>Merci de la contacter rapidement pour faire le point sur sa situation et répondre à ses éventuelles questions.</p>
            <p style="color: {{ colors.red }}"><strong>Attention :</strong> tous les dirigeants ont reçu cet email. Si vous décidez de prendre en charge le contact, pensez à prévenir les autres.</p><br>
            <h3>Informations de l’adhérent :</h3>
            <ul style="list-style: none; padding: 0;">
                <li style="margin-bottom: 1.3rem">👤 Nom : {{ membership.firstname }} {{ membership.lastname }}</li>
                <li style="margin-bottom: 1.3rem">⚧️ Sexe : {{ membership.gender.label|trans|capitalize }}</li>
                <li style="margin-bottom: 1.3rem">🎂 Date de naissance : {{ membership.birthdate|date('d/m/Y') }} ({{ age }} ans)</li>
                <li style="margin-bottom: 1.3rem"><a href="tel:+33{{ membership.phone|slice(1) }}" style="color: {{ colors.greyLight }}; text-decoration: none;">☎️ Téléphone : {{ membership.phone }}</a></li>
                <li style="margin-bottom: 1.3rem">🏠 Adresse : {{ membership.address }}, {{ membership.postalcode }} {{ membership.city }}</li>
                <li style="margin-bottom: 1.3rem"><a href="mailto:{{ membership.email }}" style="color: {{ colors.greyLight }}; text-decoration: none;">📧 Email : {{ membership.email }}</a></li>
            </ul><br>
            {% if age < 18 %}
                <h3>Informations du tuteur légal :</h3>
                <ul style="list-style: none; padding: 0;">
                    <li style="margin-bottom: 1.3rem">👤 Nom : {{ membership.tutorFirstname }} {{ membership.tutorLastname }}</li>
                    <li style="margin-bottom: 1.3rem"><a href="tel:+33{{ membership.tutorPhone|slice(1) }}" style="color: {{ colors.greyLight }}; text-decoration: none;">☎️ Téléphone : {{ membership.tutorPhone }}</a></li>
                    <li style="margin-bottom: 1.3rem">🏠 Adresse : {{ membership.tutorAddress }} {{ membership.tutorPostalcode }}, {{ membership.tutorCity }}</li>
                    <li style="margin-bottom: 1.3rem"><a href="mailto:{{ membership.tutorEmail }}" style="color: {{ colors.greyLight }}; text-decoration: none;">📧 Email : {{ membership.tutorEmail }}</a></li>
                </ul>
            {% endif %}
            <br>
            <p>Merci de votre réactivité,</p>
            <p>Les Titans</p>
        </div>
    </section>
{% endblock %}
