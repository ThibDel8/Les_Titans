{% extends 'emails/base.html.twig' %}

{% block subject %}{{ parent() }}Suppression d'un membre dirigeant{% endblock %}

{% block body %}

    <h1 style="color: {{ colors.managerColor }}; padding-bottom: 20px;">Suppression d'un membre dirigeant</h1>
    <section style="
        background-color: {{ colors.grey }};
        border-radius: 4px;
        padding: 25px;
        margin-bottom: 40px;
        border-left: 5px solid {{ colors.managerColor }};
    ">
        <div style="color: {{ colors.greyLight }};">
            <p>Bonjour {{ president.firstname }},</p><br>
            <p>Un membre de l'association vient d'être supprimé.</p>
            <p>Ce membre était {{ user.firstname }} {{ user.lastname }} et occupait le poste de {{ user.role }}.</p>
            <br>
            <p>Si ce n'est pas encore fait, pensez à attribuer le role de {{ user.role }} sur un autre membre.</p>
            <br><br>
            <p>Merci,</p>
            <p>Saint-Ouen Musculation | Les Titans</p>
        </div>
    </section>
{% endblock %}
