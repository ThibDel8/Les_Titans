{% extends 'emails/base.html.twig' %}

{% block subject %}{{ parent() }}Nouveau message de contact{% endblock %}

{% block body %}
    <h2 style="color: {{ colors.managerColor }};">Nouveau message de contact</h2>
    <div style="color: {{ colors.grey }}; margin-bottom: 20px;">
        <p>Bonjour,</p>
        <p>Un nouveau message a été reçu via le formulaire de contact.</p>
    </div>

    <section style="
        background-color: {{ colors.greyDark }};
        border-radius: 4px;
        padding: 25px;
        margin-bottom: 40px;
        border-left: 5px solid {{ colors.managerColor }};
    ">
        <h3 style="color: {{ colors.managerColor }}; margin-bottom: 40px;">Détails du message</h3>
        <div style="color: {{ colors.grey }};">
            <strong>Sujet : </strong>{{ subject }}<br><br>
            <strong>Message : </strong><br>
            {{ message }}
        </div>
    </section>

    <div style="color: {{ colors.grey }};">
        <p>
            Vous pouvez répondre à ce message depuis l’interface d’administration du site Les Titans.
        </p>
        <p>
            Information importante : la première personne à ouvrir le message depuis le site
            sera la seule autorisée à y répondre. La réponse est unique ; les échanges complémentaires
            se feront ensuite par email si nécessaire.
        </p><br>
        <p>Merci,</p>
        <p>Saint-Ouen Musculation | Les Titans</p>
    </div>
{% endblock %}
