{% extends 'emails/base.html.twig' %}

{% block subject %}{{ parent() }}Création du compte{% endblock %}

{% block body %}

    <section style="
        background-color: {{ colors.greyDark }};
        border-radius: 4px;
        padding: 25px;
        margin-bottom: 40px;
        border-left: 5px solid {{ colors.managerColor }};
    ">
        <h2 style="color: {{ colors.managerColor }}; padding-bottom: 20px;">Création de votre mot de passe</h2>
        <div style="color: {{ colors.grey }};">
            <p>Bonjour {{ user.firstname }},</p><br>
            <p>Félicitations ! Votre inscription à été validée. Vous êtes maintenant membre de l'association Saint-Ouen Musculation.</p>
            <p>Votre compte vient d’être créé. Merci de cliquer sur le lien ci-dessous pour définir votre mot de passe.</p>
            <br>
            <a href="{{ url('password_setup', {'token': token}) }}" style="color: {{ colors.managerColor }}; text-decoration: none;">Créer mon mot de passe</a>
            <br><br>
            <p>Ce lien est valable 24 heures et ne pourra être utilisé qu’une seule fois.</p>
            <br><br>
            <p>Merci,</p>
            <p>Saint-Ouen Musculation | Les Titans</p>
        </div>
    </section>
{% endblock %}
