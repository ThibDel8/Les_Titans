{% extends 'emails/base.html.twig' %}

{% block subject %}{{ parent() }}Création du compte{% endblock %}

{% block body %}

    <h1 style="color: {{ colors.publicColor }}; padding-bottom: 20px;">Création de votre mot de passe</h1>
    <section style="
        background-color: {{ colors.grey }};
        border-radius: 4px;
        padding: 25px;
        margin-bottom: 40px;
        border-left: 5px solid {{ colors.publicColor }};
    ">
        <div style="color: {{ colors.greyLight }};">
            <p>Bonjour {{ user.firstname }},</p><br>
            <p>Félicitations ! Votre inscription a été validée. Vous êtes maintenant membre de l'association Saint-Ouen Musculation.</p>
            <p>Votre compte vient d’être créé. Merci de cliquer sur le lien ci-dessous pour définir votre mot de passe.</p>
            <div style="text-align: center;"><br>
                <a href="{{ url('password_setup', {'token': token}) }}"  style="
                    color: {{ colors.black }};
                    background-color: {{ colors.publicColor }};
                    text-decoration: none;
                    border-radius: 5px;
                    padding: 5px 15px;
                    ">Créer mon mot de passe</a>
            </div><br>
            <p>Ce lien est valable 24 heures et ne pourra être utilisé qu’une seule fois.</p>
            <br><br>
            <p>Merci,</p>
            <p>Saint-Ouen Musculation | Les Titans</p>
        </div>
    </section>
{% endblock %}
