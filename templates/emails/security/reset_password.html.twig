{% extends 'emails/base.html.twig' %}

{% block subject %}{{ parent() }}Mot de passe oublié{% endblock %}

{% block body %}

    <h1 style="color: {{ colors.publicColor }}; padding-bottom: 20px;">Réinitialisation de votre mot de passe</h1>
    <section style="
        background-color: {{ colors.grey }};
        border-radius: 4px;
        padding: 25px;
        margin-bottom: 40px;
        border-left: 5px solid {{ colors.publicColor }};
    ">
        <div style="color: {{ colors.greyLight }};">
            <p>Bonjour,</p><br>
            <p>Pour réinitialiser votre mot de passe, merci de cliquer sur le bouton ci-dessous.</p>
            <div style="text-align: center;"><br>
                <a href="{{ url('app_reset_password', {token: resetToken.token}) }}" style="
                color: {{ colors.black }};
                background-color: {{ colors.publicColor }};
                text-decoration: none;
                border-radius: 5px;
                padding: 5px 15px;
            ">Réinitialiser</a>
            </div><br>
            <p>Ce bouton expirera dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.</p>
            <br><br>
            <p>Merci,</p>
            <p>Saint-Ouen Musculation | Les Titans</p>
        </div>
    </section>
{% endblock %}
