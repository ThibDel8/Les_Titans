{% set colors = {
    black: '#0f0f0f',
    publicColor: '#b6882a',
    managerColor: '#c76620',
    grey: '#f5f5f5',
    greyDark: '#2a2a2a',
    red: '#a30404',
    green: '#008000',
} %}

<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block subject %}Les Titans | {% endblock %}</title>
    </head>
    <body style="font-family: Arial, sans-serif; background-color: #121212; margin: 0; padding: 0;">
        {# Bandeau supérieur #}
        {% include 'emails/_partials/_header.html.twig' %}

        {# Contenu principal #}
        <div style="
            max-width: 1200px;
            margin: auto;
            padding: 40px 20px;
            display: grid;
            grid-template-columns: 1fr;
        ">
            {% block body %}{% endblock %}
        </div>

        {# Footer #}
        {% include 'emails/_partials/_footer.html.twig' %}
    </body>
</html>
